{
  "compilerOptions": {
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "module": "es2022",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "noUnusedLocals": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "jsx": "react-jsx",
    "lib": ["dom", "es2022"],
    "target": "es2022",
    "customConditions": ["@playroom/dev"]
  },
  "include": [
    "packages/playroom/src",
    "packages/playroom/lib",
    "packages/playroom/utils",
    "packages/playroom/bin",
    "packages/playroom/tsdown.config.mts",
    "vitest.config.mts"
  ],
  "exclude": ["cypress", "**/dist", "**/node_modules"]
}
